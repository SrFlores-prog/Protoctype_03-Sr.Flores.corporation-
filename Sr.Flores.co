<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#111116">
  <meta name="description" content="Edits personalizadas feitas para transformar suas ideias em arte. Peça a sua na Sr.Flores.co.">
  <title>Sr.Flores.co — sua ideia, nossa arte</title>
  <style>
    :root{--ink:#111116;--paper:#f4f1ec;--muted:#aaa7a2;--lime:#d8ff69;--coral:#ff735e;--violet:#a78bfa;--line:rgba(255,255,255,.15);--panel:#1b1b22;--max:1160px}
    *{box-sizing:border-box}
    html{scroll-behavior:smooth;scroll-padding-top:92px}
    body{margin:0;background:var(--ink);color:var(--paper);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;font-size:16px;line-height:1.55}
    a{color:inherit;text-decoration:none}
    button,input,select,textarea{font:inherit}
    :focus-visible{outline:3px solid var(--lime);outline-offset:4px}
    .wrap{width:min(var(--max),calc(100% - 48px));margin-inline:auto}
    .eyebrow{font-size:.76rem;font-weight:750;letter-spacing:.14em;text-transform:uppercase;color:var(--lime)}
    .topline{background:var(--lime);color:var(--ink);text-align:center;padding:9px 18px;font-size:.85rem;font-weight:750;letter-spacing:.01em}
    .topline span{margin-left:6px;font-weight:500}
    header{position:sticky;top:0;z-index:10;background:rgba(17,17,22,.9);backdrop-filter:blur(16px);border-bottom:1px solid var(--line)}
    .nav{height:76px;display:flex;align-items:center;justify-content:space-between;gap:28px}
    .brand{font-weight:850;letter-spacing:-.065em;font-size:1.25rem;white-space:nowrap}
    .brand em{font-style:normal;color:var(--lime)}
    .nav-links{display:flex;align-items:center;gap:30px;font-size:.9rem;color:#d2d0cd}
    .nav-links a:hover{color:var(--lime)}
    .nav-cta,.button{min-height:48px;display:inline-flex;align-items:center;justify-content:center;gap:10px;padding:0 20px;border:1px solid var(--lime);background:var(--lime);color:var(--ink);font-weight:760;font-size:.92rem;transition:transform .2s,background .2s}
    .nav-cta:hover,.button:hover{transform:translateY(-2px);background:#e4ff9b}
    .hero{padding:86px 0 94px;position:relative;overflow:hidden}
    .hero:before{content:"";position:absolute;width:510px;height:510px;border-radius:50%;right:-115px;top:15px;background:radial-gradient(circle at 32% 34%,rgba(255,115,94,.84),rgba(167,139,250,.64) 35%,rgba(70,57,116,.27) 58%,transparent 72%);filter:blur(10px);pointer-events:none}
    .hero:after{content:"";position:absolute;width:330px;height:330px;border-radius:50%;right:80px;top:102px;border:1px solid rgba(255,255,255,.15);box-shadow:0 0 0 25px rgba(255,255,255,.025),0 0 0 55px rgba(255,255,255,.02);pointer-events:none}
    .hero-grid{position:relative;z-index:1;display:grid;grid-template-columns:1.15fr .85fr;align-items:center;gap:68px}
    .hero h1{font-size:clamp(3.4rem,7vw,6.3rem);line-height:.94;letter-spacing:-.075em;margin:20px 0 24px;max-width:720px}
    .hero h1 span{color:var(--lime)}
    .hero-copy{max-width:510px;color:#c3c0bc;font-size:1.08rem;line-height:1.7;margin:0 0 30px}
    .hero-actions{display:flex;align-items:center;gap:22px;flex-wrap:wrap}
    .text-link{font-size:.92rem;color:var(--paper);border-bottom:1px solid rgba(255,255,255,.4);padding:7px 0}
    .welcome-card{position:relative;margin-left:auto;width:min(100%,385px);min-height:385px;padding:31px;display:flex;flex-direction:column;justify-content:space-between;background:var(--lime);color:var(--ink);transform:rotate(2deg);box-shadow:15px 20px 0 rgba(0,0,0,.16)}
    .welcome-card:before{content:"";position:absolute;inset:12px;border:1px solid rgba(17,17,22,.22);pointer-events:none}
    .card-top{display:flex;justify-content:space-between;align-items:center;font-size:.75rem;letter-spacing:.12em;font-weight:800;text-transform:uppercase}
    .spark{font-size:2.1rem;line-height:1}
    .gift-number{font-size:clamp(4.4rem,8vw,6.9rem);line-height:.86;letter-spacing:-.09em;font-weight:900}
    .gift-title{font-size:1.45rem;line-height:1.08;letter-spacing:-.045em;font-weight:850;max-width:270px}
    .gift-note{font-size:.86rem;max-width:255px;margin:10px 0 0}
    .card-bottom{display:flex;justify-content:space-between;align-items:end;border-top:1px solid rgba(17,17,22,.28);padding-top:15px;margin-top:24px;font-size:.76rem;font-weight:750;text-transform:uppercase;letter-spacing:.06em}
    .strip{border-block:1px solid var(--line);padding:17px 0;color:#d0ceca}
    .strip-row{display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;font-size:.85rem}
    .strip-row strong{color:var(--paper);font-weight:700}
    section{padding:100px 0}
    .section-head{display:flex;justify-content:space-between;align-items:end;gap:32px;margin-bottom:42px}
    h2{font-size:clamp(2.2rem,4vw,3.8rem);line-height:1;letter-spacing:-.065em;margin:12px 0 0}
    .section-lede{max-width:400px;color:#b7b4b0;margin:0;font-size:.98rem}
    .services{background:#18181f}
    .service-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
    .service{min-height:260px;padding:26px;border:1px solid var(--line);background:var(--panel);display:flex;flex-direction:column;justify-content:space-between;transition:border-color .2s,transform .2s}
    .service:hover{transform:translateY(-4px);border-color:rgba(216,255,105,.65)}
    .service-index{color:var(--lime);font-size:.75rem;letter-spacing:.14em;font-weight:800}
    .service-icon{width:44px;height:44px;border:1px solid var(--line);display:grid;place-items:center;font-size:1.25rem;color:var(--coral)}
    .service h3{font-size:1.35rem;letter-spacing:-.04em;margin:24px 0 6px}
    .service p{color:var(--muted);font-size:.92rem;margin:0;max-width:290px}
    .about-grid{display:grid;grid-template-columns:.78fr 1.22fr;gap:80px;align-items:start}
    .about-mark{min-height:310px;background:var(--violet);color:var(--ink);padding:28px;display:flex;flex-direction:column;justify-content:space-between;position:relative;overflow:hidden}
    .about-mark:after{content:"SF";position:absolute;right:-15px;bottom:-65px;font-weight:950;font-size:15rem;letter-spacing:-.13em;line-height:1;color:rgba(17,17,22,.13)}
    .about-mark .eyebrow{color:var(--ink)}
    .about-mark strong{font-size:1.8rem;line-height:1.05;letter-spacing:-.055em;max-width:210px;position:relative;z-index:1}
    .about-copy p{color:#c3c0bc;font-size:1.02rem;line-height:1.8;margin:0 0 18px;max-width:660px}
    .about-copy .signature{color:var(--lime);font-weight:750;margin-top:25px}
    .order{background:#18181f}
    .order-grid{display:grid;grid-template-columns:.78fr 1.22fr;gap:70px;align-items:start}
    .order-intro{position:sticky;top:110px}
    .order-intro p{color:#b7b4b0;max-width:360px;margin:18px 0 26px}
    .email-note{font-size:.85rem;border-left:2px solid var(--lime);padding:4px 0 4px 14px;color:#d1cfcb}
    .form{display:grid;grid-template-columns:1fr 1fr;gap:18px}
    .field{display:flex;flex-direction:column;gap:8px}
    .field.full{grid-column:1/-1}
    label{font-size:.87rem;font-weight:700;color:#eeece8}
    input,select,textarea{width:100%;border:1px solid #414149;background:#202027;color:var(--paper);border-radius:0;padding:13px 14px;min-height:50px}
    input::placeholder,textarea::placeholder{color:#929098}
    select{color:#e5e2df}
    textarea{resize:vertical;min-height:130px}
    .form-foot{grid-column:1/-1;display:flex;align-items:center;justify-content:space-between;gap:20px;margin-top:4px}
    .fineprint{color:#aaa7a2;font-size:.79rem;max-width:325px}
    .form-status{grid-column:1/-1;color:var(--lime);min-height:24px;font-size:.9rem}
    .social{padding:78px 0}
    .social-panel{display:flex;align-items:center;justify-content:space-between;gap:34px;padding:34px;border:1px solid var(--line);background:linear-gradient(110deg,rgba(167,139,250,.13),rgba(255,115,94,.07) 65%,transparent)}
    .social-panel h2{font-size:clamp(1.8rem,3vw,2.7rem)}
    .social-panel p{color:var(--muted);margin:10px 0 0}
    .social-links{display:flex;gap:10px;flex-wrap:wrap}
    .social-links a{border:1px solid var(--line);padding:12px 16px;min-height:46px;display:inline-flex;align-items:center;font-size:.88rem;transition:background .2s,border-color .2s}
    .social-links a:hover{border-color:var(--lime);background:rgba(216,255,105,.08)}
    footer{border-top:1px solid var(--line);padding:25px 0;color:#aaa7a2;font-size:.82rem}
    .footer-row{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap}
    .footer-row strong{color:var(--paper)}
    @media(max-width:850px){.hero-grid,.about-grid,.order-grid{grid-template-columns:1fr;gap:44px}.hero{padding:66px 0}.welcome-card{margin:8px auto 0;width:min(100%,440px);min-height:345px}.hero:before{right:-200px;top:240px}.hero:after{right:-30px;top:300px}.about-mark{min-height:245px}.order-intro{position:static}.section-head{align-items:start;flex-direction:column;gap:14px}.section-lede{max-width:570px}}
    @media(max-width:640px){.hero:before{right:-320px;top:440px;width:360px;height:360px}.hero:after{right:-150px;top:500px;width:280px;height:280px}.wrap{width:min(var(--max),calc(100% - 36px))}.nav{height:66px}.nav-links{display:none}.nav-cta{min-height:42px;padding:0 13px;font-size:.84rem}.topline{font-size:.77rem}.hero{padding:56px 0 62px}.hero h1{font-size:clamp(3.35rem,16vw,5rem)}.hero-copy{font-size:1rem}.hero-actions{gap:18px}.welcome-card{min-height:315px;padding:25px}.gift-number{font-size:5rem}section{padding:76px 0}.service-grid{grid-template-columns:1fr}.service{min-height:220px}.about-grid,.order-grid{gap:30px}.form{grid-template-columns:1fr;gap:15px}.field.full,.form-foot,.form-status{grid-column:1}.form-foot{align-items:start;flex-direction:column}.form-foot .button{width:100%}.social{padding:56px 0}.social-panel{align-items:flex-start;flex-direction:column;padding:25px}.social-links{width:100%}.social-links a{flex:1;justify-content:center}.footer-row{flex-direction:column}}
    @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{transition:none!important}}
  </style>
</head>
<body>
  <div class="topline">PRIMEIRA VISITA? <span>Sua primeira edit personalizada é por nossa conta — escolha o tema. ✳</span></div>
  <header>
    <nav class="nav wrap" aria-label="Navegação principal">
      <a class="brand" href="#inicio" aria-label="Sr.Flores.co — início">Sr.Flores<em>.co</em></a>
      <div class="nav-links"><a href="#criacoes">O que criamos</a><a href="#sobre">Sobre</a><a href="#redes">Redes</a></div>
      <a class="nav-cta" href="#pedido">Pedir minha edit <span aria-hidden="true">↗</span></a>
    </nav>
  </header>
  <main>
    <section class="hero" id="inicio">
      <div class="hero-grid wrap">
        <div>
          <div class="eyebrow">Sr.Flores corporation · edits personalizadas</div>
          <h1>Sua ideia.<br><span>Nossa arte.</span></h1>
          <p class="hero-copy">A gente transforma o tema que você ama em uma edit feita especialmente para você. Conte sua ideia, escolha o clima e deixe o visual com a nossa assinatura.</p>
          <div class="hero-actions"><a class="button" href="#pedido">Quero pedir uma edit <span aria-hidden="true">↗</span></a><a class="text-link" href="#sobre">Conheça a Sr.Flores.co</a></div>
        </div>
        <aside class="welcome-card" aria-label="Presente de boas-vindas: uma edit personalizada gratuita na primeira visita">
          <div class="card-top"><span>Um presente de chegada</span><span class="spark" aria-hidden="true">✳</span></div>
          <div><div class="gift-number">01<span style="font-size:.44em;vertical-align:top">×</span></div><div class="gift-title">Sua primeira edit é grátis.</div><p class="gift-note">Você escolhe o tema. A gente cria uma edit personalizada como boas-vindas.</p></div>
          <div class="card-bottom"><span>Feita pra você</span><span>Sr.Flores.co</span></div>
        </aside>
      </div>
    </section>
    <div class="strip"><div class="strip-row wrap"><span><strong>Do seu jeito.</strong> Tema, cores e referências escolhidas por você.</span><span>✳ &nbsp; Criatividade sob medida &nbsp; ✳ &nbsp; Feito com intenção</span></div></div>

    <section class="services" id="criacoes">
      <div class="wrap">
        <div class="section-head"><div><div class="eyebrow">Ideia vira imagem</div><h2>O que podemos criar</h2></div><p class="section-lede">Cada pedido começa com a sua referência. A gente combina estilo, cores e formato para chegar numa arte com a sua cara.</p></div>
        <div class="service-grid">
          <article class="service"><div><div class="service-index">01 / PERFIL</div><div class="service-icon" aria-hidden="true">A</div></div><div><h3>Edits para perfil</h3><p>Uma imagem marcante para avatar, capa ou para dar outra cara às suas redes.</p></div></article>
          <article class="service"><div><div class="service-index">02 / FÃ &amp; FANDOM</div><div class="service-icon" aria-hidden="true">✳</div></div><div><h3>Do seu universo</h3><p>Artistas, personagens, filmes, séries ou qualquer tema que faça parte do seu mundo.</p></div></article>
          <article class="service"><div><div class="service-index">03 / PRESENTE</div><div class="service-icon" aria-hidden="true">+</div></div><div><h3>Uma ideia só sua</h3><p>Uma edit personalizada para compartilhar, guardar ou surpreender alguém especial.</p></div></article>
        </div>
      </div>
    </section>

    <section id="sobre">
      <div class="about-grid wrap">
        <div class="about-mark"><span class="eyebrow">Sobre a Sr.Flores.co</span><strong>Personalidade em cada detalhe.</strong><span style="font-size:.82rem;font-weight:700">Sr.Flores corporation</span></div>
        <div class="about-copy"><div class="eyebrow">Quem somos</div><h2>Uma edit que<br>tem a sua cara.</h2><p>A Sr.Flores.co é uma empresa de edits personalizadas feita para tirar ideias da cabeça e transformar em imagem. Você escolhe o tema, compartilha as referências e conta o que gostaria de sentir ao olhar para a sua edit.</p><p>Nosso processo é simples: ouvimos o seu pedido e criamos uma arte pensada para combinar com você. E, para dar as boas-vindas, a primeira edit personalizada é gratuita — o tema fica por sua conta.</p><p class="signature">Sua ideia merece virar arte. ✳</p></div>
      </div>
    </section>

    <section class="order" id="pedido">
      <div class="order-grid wrap">
        <div class="order-intro"><div class="eyebrow">Vamos criar?</div><h2>Conta pra gente<br>sua ideia.</h2><p>Preencha o pedido com o máximo de detalhes que quiser. Ao enviar, seu aplicativo de e-mail vai abrir com a mensagem pronta para você revisar e enviar.</p><div class="email-note">Primeira vez por aqui? Marque o presente de boas-vindas e peça sua edit gratuita.</div></div>
        <form class="form" id="order-form">
          <div class="field"><label for="name">Seu nome *</label><input id="name" name="name" autocomplete="name" placeholder="Como podemos te chamar?" required></div>
          <div class="field"><label for="email">Seu e-mail *</label><input id="email" name="email" type="email" autocomplete="email" placeholder="voce@exemplo.com" required></div>
          <div class="field"><label for="type">O que você quer pedir? *</label><select id="type" name="type" required><option value="" disabled selected>Escolha uma opção</option><option>Edit personalizada</option><option>Presente de boas-vindas — primeira edit grátis</option><option>Quero conversar sobre uma ideia</option></select></div>
          <div class="field"><label for="format">Onde vai usar?</label><select id="format" name="format"><option>Escolha se já souber</option><option>Foto de perfil</option><option>Story / publicação</option><option>Capa / banner</option><option>Outro formato</option></select></div>
          <div class="field full"><label for="theme">Qual é o tema da edit? *</label><input id="theme" name="theme" placeholder="Ex.: meu artista favorito, um personagem, uma paleta..." required></div>
          <div class="field full"><label for="details">Conte os detalhes</label><textarea id="details" name="details" placeholder="Cores, estilo, texto, referências ou qualquer detalhe que ajude a imaginar sua edit..."></textarea></div>
          <div class="field full"><label for="reference">Link de referência (opcional)</label><input id="reference" name="reference" type="url" placeholder="https://"></div>
          <div class="form-foot"><span class="fineprint">Ao continuar, seu app de e-mail abrirá uma mensagem endereçada à Sr.Flores.co. Revise e toque em enviar para concluir.</span><button class="button" type="submit">Preparar meu pedido <span aria-hidden="true">↗</span></button></div>
          <div class="form-status" id="form-status" aria-live="polite" role="status"></div>
        </form>
      </div>
    </section>

    <section class="social" id="redes">
      <div class="social-panel wrap"><div><div class="eyebrow">A gente se encontra por aí</div><h2>Segue a Sr.Flores.co</h2><p>Siga-nos nas redes sociais e veja o que acha do nosso trabalho.</p></div><div class="social-links" aria-label="Espaço para redes sociais"><a href="https://www.instagram.com/srflores_yt?dlrf=MnI0a3lmcGNjM2s=" target="_blank" rel="noopener noreferrer">Instagram ↗</a><a href="https://vm.tiktok.com/ZS9DYLGkXPEwH-YFLAE/" target="_blank" rel="noopener noreferrer">TikTok ↗</a><a href="https://www.youtube.com/@Sr.Flores_yt" target="_blank" rel="noopener noreferrer">YouTube ↗</a></div></div>
    </section>
  </main>
  <footer><div class="footer-row wrap"><span><strong>Sr.Flores.co</strong> · Sr.Flores corporation</span><span>Edits personalizadas, feitas com intenção. ✳</span></div></footer>
  <script>
    const form = document.getElementById('order-form');
    const status = document.getElementById('form-status');
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      const data = new FormData(form);
      const body = [
        'NOVO PEDIDO — SR.FLORES.CO', '',
        `Nome: ${data.get('name')}`,
        `E-mail para contato: ${data.get('email')}`,
        `Pedido: ${data.get('type')}`,
        `Formato: ${data.get('format') || 'Não informado'}`,
        `Tema: ${data.get('theme')}`,
        `Detalhes: ${data.get('details') || 'Não informado'}`,
        `Referência: ${data.get('reference') || 'Não informada'}`
      ].join('\n');
      const subject = encodeURIComponent(`Pedido de edit — ${data.get('name')}`);
      const message = encodeURIComponent(body);
      status.textContent = 'Abrindo seu aplicativo de e-mail com o pedido preenchido…';
      window.location.href = `mailto:ezequielcrupinskiflores@gmail.com?subject=${subject}&body=${message}`;
    });
  </script>
</body>
</html>
